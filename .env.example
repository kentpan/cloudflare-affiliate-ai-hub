# AI 推理
LLMAI_APIKEY=
LLMAI_BASE_URL=https://llmapi.xubaoge.com/v1
LLMAI_MODEL=glm-5.2

# Amazon Product Advertising API 5.0
AMZ_ACCESS_KEY=
AMZ_SECRET_KEY=
AMZ_PARTNER_TAG=
AMZ_MARKETPLACE=www.amazon.com
AMZ_HOST=webservices.amazon.com
AMZ_REGION=us-east-1

# 淘宝联盟（淘宝客）开放平台
TBK_APP_KEY=
TBK_APP_SECRET=
TBK_ADZONE_ID=
TBK_PID=

# 京东联盟开放平台
JD_APP_KEY=
JD_APP_SECRET=
JD_ACCESS_TOKEN=
JD_SITE_ID=

# Google Programmable Search Engine
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 拼多多多多客联盟(选填,未配置时用 mock 数据)
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# 抖音电商精选联盟(选填,未配置时用 mock 数据)
DY_APP_KEY=
DY_APP_SECRET=
DY_PID=

# 快手电商联盟(选填,未配置时用 mock 数据)
KS_APP_KEY=
KS_APP_SECRET=

# 小红书蒲公英联盟(选填,未配置时用 mock 数据,需企业资质 + 白名单)
XHS_APP_ID=
XHS_APP_SECRET=

# 推送目标（支持多个，英文逗号分隔）
# 全链路自动触发示例（daily-picker.yml 选品完成后自动推送选品到 3 个端点）:
#   1) xian18-shop 联盟商品入库  + 短链生成
#   2) matrix-tentans 飞书知识库 product 表写入
#   3) matrix-tentans 全链路编排: AI 写作 → 文章入飞书 article 表 → 公众号草稿推送
RECEIVE_URL=https://xian18-shop.example.com/api/seed/receive,https://matrix-tentans.example.com/api/feishu-wikis/ingest,https://matrix-tentans.example.com/api/full-pipeline/run

# 数据目录（默认 .data 相对项目根）
DATA_DIR=

# ---------- 矩阵管理系统(matrix-tentans)同步 ----------
# matrix-tentans 的公网地址(开发环境用 localhost,生产环境用域名)
MATRIX_GATEWAY_URL=http://localhost:3002
# 站点级 Bearer 密钥(32 hex,无 vab_sk_ 前缀) — 鉴权 + 推送 token 复用此 key
# 首次部署时请在 matrix-tentans 后台「API 密钥」页面生成并复制到这里
# v3.9: RECEIVE_TOKEN 已废弃, push.token 也读 MATRIX_API_KEY, 与 matrix-sync SDK 统一
MATRIX_API_KEY=
